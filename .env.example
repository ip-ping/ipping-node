# Copy to .env and edit. Used by compose.yaml (and read by `ipping-node run` as IPPING_NODE_*).

# Backend address, as seen from this host.
IPPING_NODE_SERVER=https://ping.example.com

# Single-use token from the admin page. Only needed for the first start; the node stores its own
# credential in the state volume and ignores the token afterwards. Remove it once enrolled.
IPPING_NODE_ENROLL_TOKEN=

# What the public node list shows (an administrator can correct these).
IPPING_NODE_NAME=my-node
IPPING_NODE_COUNTRY=
IPPING_NODE_CITY=
IPPING_NODE_PROVIDER=

# Most tasks this node runs at once.
IPPING_NODE_MAX_TASKS=8
